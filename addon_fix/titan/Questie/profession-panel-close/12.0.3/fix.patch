+local function ReadPlayerProfessions()
+    local professions = {}
+    local getCount = C_SkillInfo and C_SkillInfo.GetNumSkillLines or GetNumSkillLines
+    if C_SkillInfo and type(C_SkillInfo.GetSkillLineInfoByID) == "function" then
+        local count = getCount and getCount()
+        if not count or count <= 0 then return nil end
+        for _, professionId in pairs(QuestieProfessions.professionKeys) do
+            local info = C_SkillInfo.GetSkillLineInfoByID(professionId)
+            if issecretvalue and issecretvalue(info) then return nil end
+            if info then
+                if issecretvalue and (issecretvalue(info.name) or issecretvalue(info.rank)
+                    or issecretvalue(info.maxRank)) then return nil end
+                if type(info.name) ~= "string" or type(info.rank) ~= "number"
+                    or type(info.maxRank) ~= "number" then return nil end
+                if info.maxRank > 0 then professions[professionId] = {info.name, info.rank} end
+            end
+        end
+        return professions
+    end
+
+    if not GetSkillLineInfo then
+        -- Profession indices can contain empty slots before learned secondary professions.
+        for _, index in pairs({GetProfessions()}) do
+            local name, _, rank, _, _, _, professionId = GetProfessionInfo(index)
+            if name and rank and professionId then professions[professionId] = {name, rank} end
+        end
+        return professions
+    end
+
+    if not ExpandSkillHeader or not CollapseSkillHeader then return nil end
+    local count = GetNumSkillLines()
+    if not count or count <= 0 then return nil end
+    local collapsed = {}
+    for index = 1, count do
+        local name, isHeader, isExpanded = GetSkillLineInfo(index)
+        if isHeader and not isExpanded then collapsed[name] = true end
+    end
+
+    local ok = pcall(function()
+        ExpandSkillHeader(0)
+        -- MoP's Ways of Cooking add skill lines before the weapon skills.
+        local maxSkillLineToCheck = Expansions.Current >= Expansions.MoP and 20 or 14
+        for index = 1, math.min(GetNumSkillLines(), maxSkillLineToCheck) do
+            local name, isHeader, _, rank = GetSkillLineInfo(index)
+            local professionId = professionTable[name]
+            if name and not isHeader and professionId then
+                if type(rank) ~= "number" then error("Profession rank unavailable") end
+                professions[professionId] = {name, rank}
+            end
+        end
+    end)
+
+    -- Restore the original collapsed categories even if expansion or a read failed.
+    local countOK, restoreCount = pcall(GetNumSkillLines)
+    if not countOK or type(restoreCount) ~= "number" then return nil end
+    for index = restoreCount, 1, -1 do
+        local readable, name, isHeader, isExpanded = pcall(GetSkillLineInfo, index)
+        if not readable then
+            ok = false
+        elseif isHeader and isExpanded and collapsed[name] then
+            if not pcall(CollapseSkillHeader, index) then ok = false end
+        end
+    end
+    return ok and professions or nil
+end
+
