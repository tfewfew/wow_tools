@@ -659,6 +668,24 @@
         -- Do UpdateAllQuests() again at next QUEST_LOG_UPDATE if there was "cacheMiss" (game's cache and addon's cache didn't have all required data yet)
         lastMarkerQuestEventTime = GetTime()
     end
+end
+
+--- Merges full-scan requests into one scan one second after the first request.
+---@param doRetryWithoutChanges boolean
+function _QuestEventHandler:UpdateAllQuests(doRetryWithoutChanges)
+    retryUnchangedQuestLogScan = retryUnchangedQuestLogScan or doRetryWithoutChanges
+    if questLogScanQueued then
+        return
+    end
+
+    questLogScanQueued = true
+    C_Timer.After(1, function()
+        local retry = retryUnchangedQuestLogScan
+        -- A request raised during the scan belongs to the next window.
+        questLogScanQueued = false
+        retryUnchangedQuestLogScan = false
+        _ScanQuestLog(retry)
+    end)
 end
 
