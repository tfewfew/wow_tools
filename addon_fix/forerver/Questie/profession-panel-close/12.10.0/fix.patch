+local function ReadPlayerProfessions()
+    local professions = {}
+    local count = QuestieCompat.GetNumSkillLines()
+    if not count or count <= 0 then return nil end
+
+    if C_SkillInfo and type(C_SkillInfo.GetSkillLineInfoByID) == "function" then
+        -- Native ID queries include learned professions inside collapsed categories.
+        for professionId in pairs(professionIds) do
+            local info = C_SkillInfo.GetSkillLineInfoByID(professionId)
+            if issecretvalue and issecretvalue(info) then return nil end
+            if info then
+                if issecretvalue and (issecretvalue(info.name) or issecretvalue(info.rank)
+                    or issecretvalue(info.maxRank)) then return nil end
+                if type(info.name) ~= "string" or type(info.rank) ~= "number"
+                    or type(info.maxRank) ~= "number" then return nil end
+                if info.maxRank > 0 then
+                    professions[professionId] = {info.name, info.rank}
+                end
+            end
+        end
+        return professions
+    end
+
+    local function ReadHeader(index)
+        if C_SkillInfo and C_SkillInfo.GetSkillLineInfo then
+            local info = assert(C_SkillInfo.GetSkillLineInfo(index), "Skill line unavailable")
+            return info.name, info.isHeader, info.isCollapsed
+        end
+        local name, isHeader, isExpanded = GetSkillLineInfo(index)
+        return name, isHeader, not isExpanded
+    end
+    local collapse = C_SkillInfo and C_SkillInfo.CollapseSkillHeader or CollapseSkillHeader
+    local collapsed = {}
+    for index = 1, count do
+        local name, isHeader, isCollapsed = ReadHeader(index)
+        if isHeader and isCollapsed then collapsed[name] = true end
+    end
+
+    local ok = pcall(function()
+        QuestieCompat.ExpandAllSkillHeaders()
+        -- Preserve the legacy localized-name scan and its profession-line boundary.
+        local maxSkillLineToCheck = Expansions.Current >= Expansions.MoP and 20 or 14
+        for index = 1, QuestieCompat.GetNumSkillLines() do
+            local name, isHeader, rank, skillLineId = QuestieCompat.GetSkillLineInfo(index)
+            if not skillLineId and index > maxSkillLineToCheck then break end
+            local professionId
+            if skillLineId then
+                professionId = professionIds[skillLineId] and skillLineId
+            else
+                professionId = professionTable[name]
+            end
+            if name and not isHeader and professionId then
+                professions[professionId] = {name, rank}
+            end
+        end
+    end)
+
+    -- Restore every original collapsed header even when a read or expansion failed.
+    local countOK, restoreCount = pcall(QuestieCompat.GetNumSkillLines)
+    if not countOK or type(restoreCount) ~= "number" then return nil end
+    for index = restoreCount, 1, -1 do
+        local readable, name, isHeader = pcall(ReadHeader, index)
+        if not readable then
+            ok = false
+        elseif isHeader and collapsed[name] then
+            if not pcall(collapse, index) then ok = false end
+        end
+    end
+    return ok and professions or nil
+end
